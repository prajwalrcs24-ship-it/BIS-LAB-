
import random
import heapq

random.seed(10)

# ==========================================
# AGV SCHEDULING AND ROUTING USING GA + DIJKSTRA
# ==========================================

# Warehouse graph: node -> (neighbor, distance)
graph = {
    'A': [('B', 4), ('C', 2)],
    'B': [('A', 4), ('C', 1), ('D', 5)],
    'C': [('A', 2), ('B', 1), ('D', 8), ('E', 10)],
    'D': [('B', 5), ('C', 8), ('E', 2)],
    'E': [('C', 10), ('D', 2)]
}

# Tasks: (pickup, delivery)
tasks = {
    0: ('A', 'D'),
    1: ('B', 'E'),
    2: ('C', 'D'),
    3: ('A', 'E'),
    4: ('D', 'B')
}

NUM_AGVS = 2
POP_SIZE = 6
GENERATIONS = 5
MUTATION_RATE = 0.2
CROSSOVER_RATE = 0.8

# ==========================================
# STEP 1: DIJKSTRA'S SHORTEST PATH ALGORITHM
# ==========================================

def dijkstra(start, goal):
    pq = [(0, start, [start])]
    visited = set()

    while pq:
        cost, node, path = heapq.heappop(pq)

        if node in visited:
            continue

        visited.add(node)

        if node == goal:
            return cost, path

        for neighbor, weight in graph[node]:
            if neighbor not in visited:
                heapq.heappush(
                    pq, (cost + weight, neighbor, path + [neighbor])
                )

    return float('inf'), []

# ==========================================
# STEP 2: EVALUATE CHROMOSOME / SCHEDULE
# ==========================================

def evaluate(chromosome, show=False):

    agvs = [
        {'location': 'A', 'time': 0, 'route': []}
        for _ in range(NUM_AGVS)
    ]

    total_distance = 0

    if show:
        print("\nEvaluating schedule:", chromosome)

    for task_id in chromosome:

        pickup, delivery = tasks[task_id]

        best_agv = None
        best_finish = float('inf')
        best_details = None

        # Find AGV that can complete this task earliest
        for i, agv in enumerate(agvs):

            d1, path1 = dijkstra(agv['location'], pickup)
            d2, path2 = dijkstra(pickup, delivery)

            finish = agv['time'] + d1 + d2

            if finish < best_finish:
                best_finish = finish
                best_agv = i
                best_details = (d1, path1, d2, path2)

        agv = agvs[best_agv]

        d1, path1, d2, path2 = best_details

        if show:
            print(
                f"Task {task_id}: AGV {best_agv + 1} | "
                f"Pickup {pickup} | Delivery {delivery}"
            )
            print("  Path to pickup:", path1, "Distance:", d1)
            print("  Path to delivery:", path2, "Distance:", d2)
            print("  Completion time:", best_finish)

        agv['time'] = best_finish
        agv['location'] = delivery
        agv['route'].append(task_id)

        total_distance += d1 + d2

    makespan = max(agv['time'] for agv in agvs)

    if show:
        for i, agv in enumerate(agvs):
            print(
                f"AGV {i + 1}: Tasks {agv['route']} | "
                f"Time {agv['time']}"
            )

        print("Total distance:", total_distance)
        print("Makespan:", makespan)

    return makespan

# ==========================================
# STEP 3: FITNESS FUNCTION
# ==========================================

def fitness(chromosome):
    return 1 / (evaluate(chromosome) + 1)

# ==========================================
# STEP 4: INITIAL POPULATION
# ==========================================

def create_population():
    population = []

    for _ in range(POP_SIZE):
        chromosome = list(tasks.keys())
        random.shuffle(chromosome)
        population.append(chromosome)

    return population

# ==========================================
# STEP 5: SELECTION
# ==========================================

def selection(population):
    candidates = random.sample(population, 2)
    return max(candidates, key=fitness)

# ==========================================
# STEP 6: ORDER CROSSOVER
# ==========================================

def crossover(p1, p2):

    start, end = sorted(random.sample(range(len(p1)), 2))

    child = [-1] * len(p1)
    child[start:end + 1] = p1[start:end + 1]

    remaining = [x for x in p2 if x not in child]

    j = 0

    for i in range(len(child)):
        if child[i] == -1:
            child[i] = remaining[j]
            j += 1

    return child

# ==========================================
# STEP 7: MUTATION
# ==========================================

def mutation(chromosome):

    if random.random() < MUTATION_RATE:

        i, j = random.sample(range(len(chromosome)), 2)

        chromosome[i], chromosome[j] = (
            chromosome[j], chromosome[i]
        )

        print("Mutation: swapped positions", i, "and", j)

    return chromosome

# ==========================================
# STEP 8: GENETIC ALGORITHM
# ==========================================

population = create_population()

print("\n========== INITIAL POPULATION ==========")

for i, chromosome in enumerate(population):
    print(
        f"Chromosome {i + 1}: {chromosome} | "
        f"Makespan: {evaluate(chromosome)} | "
        f"Fitness: {fitness(chromosome):.4f}"
    )

best_solution = min(population, key=evaluate)

for generation in range(1, GENERATIONS + 1):

    print(f"\n========== GENERATION {generation} ==========")

    new_population = []

    # Elitism
    elite = min(population, key=evaluate)
    new_population.append(elite[:])

    print("Best chromosome:", elite)
    print("Best makespan:", evaluate(elite))

    while len(new_population) < POP_SIZE:

        parent1 = selection(population)
        parent2 = selection(population)

        print("\nParent 1:", parent1)
        print("Parent 2:", parent2)

        if random.random() < CROSSOVER_RATE:
            child = crossover(parent1, parent2)
            print("Crossover performed")
        else:
            child = parent1[:]
            print("Crossover skipped")

        print("Child:", child)

        child = mutation(child)

        print("Child after mutation:", child)
        print("Child makespan:", evaluate(child))

        new_population.append(child)

    population = new_population

    generation_best = min(population, key=evaluate)

    if evaluate(generation_best) < evaluate(best_solution):
        best_solution = generation_best[:]

    print("\nNew population:")

    for i, chromosome in enumerate(population):
        print(
            f"{i + 1}. {chromosome} | "
            f"Makespan: {evaluate(chromosome)}"
        )

# ==========================================
# STEP 9: FINAL OPTIMAL SCHEDULE
# ==========================================

print("\n========== FINAL BEST SOLUTION ==========")

print("Best task sequence:", best_solution)
print("Minimum makespan:", evaluate(best_solution))

print("\n========== FINAL AGV ROUTING DETAILS ==========")

evaluate(best_solution, show=True)
